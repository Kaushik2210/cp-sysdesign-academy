{
  "title": "KMP prefix function and pattern counting",
  "summary": "Count every occurrence of a pattern in a text in linear time by reusing the longest matching border instead of restarting.",
  "complexity": "O(n + m)",
  "tags": [
    "strings",
    "kmp"
  ],
  "lessons": [],
  "usage": "The prefix function `pi[i]` is the length of the longest proper prefix of `s[0..i]` that is also a suffix. Gluing `pattern + '#' + text` (with a separator that cannot occur in either string) turns pattern search into 'find positions where pi equals the pattern length'. The same array gives the smallest period of a string (`n - pi[n-1]` when it divides n) and every border. The Z-function is an equivalent alternative.",
  "tests": [
    {
      "input": "ababababa\naba\n",
      "output": "4\n"
    },
    {
      "input": "aaaaa\naa\n",
      "output": "4\n"
    },
    {
      "input": "abc\nd\n",
      "output": "0\n"
    },
    {
      "input": "abc\nabcd\n",
      "output": "0\n"
    },
    {
      "input": "a\na\n",
      "output": "1\n"
    },
    {
      "input": "\nabab\n",
      "output": "123\n"
    },
    {
      "input": "\nca\n",
      "output": "221\n"
    },
    {
      "input": "\\n",
      "output": "1501\n"
    }
  ]
}
