  "hints": [
    "Simulating k single steps is too slow when k is 10^9.",
    "Rotating by n positions returns the original array. What does that say about k?",
    "Use k mod n, then output a[k..n-1] followed by a[0..k-1]."
  ],
  "editorial": "Rotating by `n` is the identity, so only `k mod n` matters. After that, the answer is `a[k:] + a[:k]`. The classic bugs are simulating `k` steps (TLE) and forgetting the modulo so that an index runs past the end (RE). Checking `k = 0`, `k = n`, `k > n` and `n = 1` by hand finds all of them.",
  "complexity": {
    "time": "O(n)",
    "space": "O(n)"
  },
  "starter": {
    "python": "n, k = map(int, input().split())\na = list(map(int, input().split()))\n# your code here\n",
    "javascript": "const [n, k] = readLine().split(' ').map(Number);\nconst a = readLine().split(' ').map(Number);\n// your code here\n",
    "cpp": "#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    // read the input and print the answer\n}\n",
    "java": "import java.util.*;\nimport java.io.*;\n\npublic class Main {\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        // read the input and print the answer\n    }\n}\n"
  },
  "solutions": {
    "python": "n, k = map(int, input().split())\na = list(map(int, input().split()))\nk %= n\nprint(*(a[k:] + a[:k]))\n",
    "javascript": "const [n, k0] = readLine().split(' ').map(Number);\nconst a = readLine().split(' ').map(Number);\nconst k = k0 % n;\nconsole.log(a.slice(k).concat(a.slice(0, k)).join(' '));\n",
    "java": "import java.util.*;\nimport java.io.*;\n\npublic class Main {\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        long k = Long.parseLong(st.nextToken()) % n;\n        st = new StringTokenizer(br.readLine());\n        long[] a = new long[n];\n        for (int i = 0; i < n; i++) a[i] = Long.parseLong(st.nextToken());\n        StringBuilder sb = new StringBuilder();\n        for (int i = 0; i < n; i++) {\n            if (i > 0) sb.append(' ');\n            sb.append(a[(int) ((i + k) % n)]);\n        }\n        System.out.println(sb);\n    }\n}\n",
    "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    int n;\n    long long k;\n    cin >> n >> k;\n    vector<long long> a(n);\n    for (auto &x : a) cin >> x;\n    k %= n;\n    for (int i = 0; i < n; i++) {\n        if (i) cout << ' ';\n        cout << a[(i + k) % n];\n    }\n    cout << \"\\n\";\n}\n"
  }
