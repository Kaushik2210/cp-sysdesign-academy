{
  "id": "m07-josephus-queue",
  "title": "Counting-Out Game",
  "source": {
    "name": "Original exercise; classic technique"
  },
  "rating": 1000,
  "tags": [
    "queue",
    "simulation"
  ],
  "statement": "`n` children stand in a circle, numbered `1..n` in clockwise order. Starting with child `1`, count `k` children clockwise (child `1` is count 1). The child at count `k` leaves the circle, and counting restarts from the next child still in the circle. This repeats until nobody remains.\n\n**Input.** One line with `n` and `k`.\n\n**Output.** The `n` numbers in the order the children leave, separated by spaces.",
  "constraints": [
    "1 ≤ n ≤ 3000",
    "1 ≤ k ≤ 10^9"
  ],
  "timeLimitMs": 2000,
