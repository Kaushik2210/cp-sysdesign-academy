  "solutions": {
    "python": "import sys\n\ndef main():\n    d = sys.stdin.read().split()\n    n, q = int(d[0]), int(d[1])\n    a = list(map(int, d[2:2 + n]))\n    diff = [0] * (n + 1)\n    p = 2 + n\n    for _ in range(q):\n        l, r, x = int(d[p]), int(d[p + 1]), int(d[p + 2])\n        p += 3\n        diff[l - 1] += x\n        diff[r] -= x\n    cur = 0\n    out = []\n    for i in range(n):\n        cur += diff[i]\n        out.append(a[i] + cur)\n    print(\" \".join(map(str, out)))\n\nmain()\n",
    "javascript": "const __L = [];\nlet __s;\nwhile ((__s = readLine()) !== null) __L.push(__s);\nconst T = __L.join(' ').split(/\\s+/).filter((x) => x.length).map(Number);\nconst n = T[0], q = T[1];\nconst diff = new Array(n + 1).fill(0);\nlet p = 2 + n;\nfor (let j = 0; j < q; j++) {\n  const l = T[p], r = T[p + 1], x = T[p + 2];\n  p += 3;\n  diff[l - 1] += x;\n  diff[r] -= x;\n}\nlet cur = 0;\nconst out = [];\nfor (let i = 0; i < n; i++) {\n  cur += diff[i];\n  out.push(T[2 + i] + cur);\n}\nconsole.log(out.join(\" \"));\n",
    "java": "import java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static StreamTokenizer st;\n\n    static long nl() throws IOException {\n        st.nextToken();\n        return (long) st.nval;\n    }\n\n    public static void main(String[] args) throws IOException {\n        st = new StreamTokenizer(new BufferedInputStream(System.in));\n        int n = (int) nl(), q = (int) nl();\n        long[] a = new long[n];\n        for (int i = 0; i < n; i++) a[i] = nl();\n        long[] diff = new long[n + 1];\n        for (int j = 0; j < q; j++) {\n            int l = (int) nl(), r = (int) nl();\n            long x = nl();\n            diff[l - 1] += x;\n            diff[r] -= x;\n        }\n        long cur = 0;\n        StringBuilder sb = new StringBuilder();\n        for (int i = 0; i < n; i++) {\n            cur += diff[i];\n            if (i > 0) sb.append(' ');\n            sb.append(a[i] + cur);\n        }\n        System.out.println(sb);\n    }\n}\n",
    "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main() {\n    int n, q;\n    scanf(\"%d %d\", &n, &q);\n    vector<long long> a(n), diff(n + 1, 0);\n    for (auto &v : a) scanf(\"%lld\", &v);\n    while (q--) {\n        int l, r;\n        long long x;\n        scanf(\"%d %d %lld\", &l, &r, &x);\n        diff[l - 1] += x;\n        diff[r] -= x;\n    }\n    long long cur = 0;\n    for (int i = 0; i < n; i++) {\n        cur += diff[i];\n        printf(\"%lld%c\", a[i] + cur, i + 1 < n ? ' ' : '\\n');\n    }\n}\n"
