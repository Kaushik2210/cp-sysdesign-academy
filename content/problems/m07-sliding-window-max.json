  "hints": [
    "Recomputing max over k elements per window is O(nk). What information from the previous window can you reuse?",
    "An element that is smaller than a LATER element in the same window can never be the maximum again. Such elements can be thrown away.",
    "Keep a deque of indices with strictly decreasing values. Push the new index at the back after popping smaller-or-equal ones; pop the front if it has left the window; the front is the maximum."
  ],
  "editorial": "Maintain a deque of indices such that values are decreasing from front to back. When `a[i]` arrives, pop from the back every index with `a[j] <= a[i]`: they are older *and* not larger, so they can never again be the window maximum. Push `i`. If the front index is `<= i - k` it has slid out of the window, so pop it from the front (at most one index can expire per step). The front is then the maximum of the window ending at `i`.\n\nEvery index enters and leaves the deque once, so the total is `O(n)`, independent of `k`.",
  "complexity": {
    "time": "O(n)",
    "space": "O(n)"
  },
  "starter": {
    "python": "import sys\n# sliding window maximum with a deque\ndata = sys.stdin.read().split()\n# your code here\n",
    "javascript": "// sliding window maximum with a deque\n// readLine() returns the next input line (or null).\n// your code here\n",
    "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main() {\n    // sliding window maximum with a deque\n    return 0;\n}\n",
    "java": "import java.util.*;\nimport java.io.*;\n\npublic class Main {\n    public static void main(String[] args) throws IOException {\n        // sliding window maximum with a deque\n    }\n}\n"
  },
  "solutions": {
    "python": "import sys\nfrom collections import deque\ndata = sys.stdin.read().split()\nn, k = int(data[0]), int(data[1])\na = list(map(int, data[2:2+n]))\ndq = deque()  # indices, values decreasing\nout = []\nfor i in range(n):\n    while dq and a[dq[-1]] <= a[i]:\n        dq.pop()\n    dq.append(i)\n    if dq[0] <= i - k:\n        dq.popleft()\n    if i >= k - 1:\n        out.append(a[dq[0]])\nprint(' '.join(map(str, out)))\n",
    "javascript": "const [n, k] = readLine().trim().split(/\\s+/).map(Number);\nconst a = readLine().trim().split(/\\s+/).map(Number);\nconst dq = new Array(n);\nlet head = 0, tail = 0;\nconst out = [];\nfor (let i = 0; i < n; i++) {\n  while (tail > head && a[dq[tail - 1]] <= a[i]) tail--;\n  dq[tail++] = i;\n  if (dq[head] <= i - k) head++;\n  if (i >= k - 1) out.push(a[dq[head]]);\n}\nconsole.log(out.join(' '));\n",
    "java": "import java.util.*;\nimport java.io.*;\n\npublic class Main {\n    public static void main(String[] args) throws IOException {\n        StreamTokenizer in = new StreamTokenizer(new BufferedInputStream(System.in));\n        in.nextToken();\n        int n = (int) in.nval;\n        in.nextToken();\n        int k = (int) in.nval;\n        long[] a = new long[n];\n        for (int i = 0; i < n; i++) { in.nextToken(); a[i] = (long) in.nval; }\n        int[] dq = new int[n];\n        int head = 0, tail = 0;\n        StringBuilder sb = new StringBuilder();\n        for (int i = 0; i < n; i++) {\n            while (tail > head && a[dq[tail - 1]] <= a[i]) tail--;\n            dq[tail++] = i;\n            if (dq[head] <= i - k) head++;\n            if (i >= k - 1) {\n                if (sb.length() > 0) sb.append(' ');\n                sb.append(a[dq[head]]);\n            }\n        }\n        System.out.println(sb);\n    }\n}\n",
    "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main() {\n    int n, k;\n    cin >> n >> k;\n    vector<long long> a(n);\n    for (auto &x : a) cin >> x;\n    deque<int> dq;\n    bool first = true;\n    for (int i = 0; i < n; i++) {\n        while (!dq.empty() && a[dq.back()] <= a[i]) dq.pop_back();\n        dq.push_back(i);\n        if (dq.front() <= i - k) dq.pop_front();\n        if (i >= k - 1) {\n            if (!first) cout << ' ';\n            first = false;\n            cout << a[dq.front()];\n        }\n    }\n    cout << \"\\n\";\n    return 0;\n}\n"
  }
