  "solutions": {
    "python": "import sys, random\ndata = sys.stdin.read().split()\ns = data[0]\nk = int(data[1])\nn = len(s)\nM1, M2 = (1 << 61) - 1, 1_000_000_007\nB1 = random.randrange(10**6, M1 - 1)\nB2 = random.randrange(10**6, M2 - 1)\nh1 = [0] * (n + 1)\nh2 = [0] * (n + 1)\nfor i, ch in enumerate(s):\n    h1[i + 1] = (h1[i] * B1 + ord(ch)) % M1\n    h2[i + 1] = (h2[i] * B2 + ord(ch)) % M2\nt1 = pow(B1, k, M1)\nt2 = pow(B2, k, M2)\nseen = set()\nfor i in range(n - k + 1):\n    seen.add(((h1[i + k] - h1[i] * t1) % M1, (h2[i + k] - h2[i] * t2) % M2))\nprint(len(seen))\n",
    "javascript": "const s = readLine().trim();\nconst k = parseInt(readLine());\nconst n = s.length;\nconst P1 = 94905991, P2 = 94905989;\nconst B1 = 1000 + Math.floor(Math.random() * (P1 - 2000));\nconst B2 = 1000 + Math.floor(Math.random() * (P2 - 2000));\nconst h1 = new Array(n + 1).fill(0), h2 = new Array(n + 1).fill(0);\nlet t1 = 1, t2 = 1;\nfor (let i = 0; i < k; i++) { t1 = (t1 * B1) % P1; t2 = (t2 * B2) % P2; }\nfor (let i = 0; i < n; i++) {\n  const c = s.charCodeAt(i);\n  h1[i + 1] = (h1[i] * B1 + c) % P1;\n  h2[i + 1] = (h2[i] * B2 + c) % P2;\n}\nconst seen = new Set();\nfor (let i = 0; i + k <= n; i++) {\n  const x = ((h1[i + k] - (h1[i] * t1) % P1) % P1 + P1) % P1;\n  const y = ((h2[i + k] - (h2[i] * t2) % P2) % P2 + P2) % P2;\n  seen.add(x * P2 + y);\n}\nconsole.log(seen.size);\n",
    "java": "import java.util.*;\nimport java.io.*;\n\npublic class Main {\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String s = br.readLine().trim();\n        int k = Integer.parseInt(br.readLine().trim());\n        int n = s.length();\n        final long M1 = 1_000_000_007L, M2 = 998_244_353L;\n        Random rnd = new Random();\n        long B1 = 1000 + rnd.nextInt((int) M1 - 2000);\n        long B2 = 1000 + rnd.nextInt((int) M2 - 2000);\n        long[] h1 = new long[n + 1], h2 = new long[n + 1];\n        long t1 = 1, t2 = 1;\n        for (int i = 0; i < k; i++) { t1 = t1 * B1 % M1; t2 = t2 * B2 % M2; }\n        for (int i = 0; i < n; i++) {\n            h1[i + 1] = (h1[i] * B1 + s.charAt(i)) % M1;\n            h2[i + 1] = (h2[i] * B2 + s.charAt(i)) % M2;\n        }\n        HashSet<Long> seen = new HashSet<>();\n        for (int i = 0; i + k <= n; i++) {\n            long x = ((h1[i + k] - h1[i] * t1) % M1 + M1) % M1;\n            long y = ((h2[i + k] - h2[i] * t2) % M2 + M2) % M2;\n            seen.add(x * M2 + y);\n        }\n        System.out.println(seen.size());\n    }\n}\n",
    "cpp": "#include <bits/stdc++.h>\nusing namespace std;\ntypedef long long ll;\nint main() {\n    string s;\n    int k;\n    cin >> s >> k;\n    int n = s.size();\n    const ll M1 = 1000000007LL, M2 = 998244353LL;\n    mt19937_64 rng(chrono::steady_clock::now().time_since_epoch().count());\n    ll B1 = 1000 + rng() % (M1 - 2000), B2 = 1000 + rng() % (M2 - 2000);\n    vector<ll> h1(n + 1, 0), h2(n + 1, 0);\n    ll t1 = 1, t2 = 1;\n    for (int i = 0; i < k; i++) { t1 = t1 * B1 % M1; t2 = t2 * B2 % M2; }\n    for (int i = 0; i < n; i++) {\n        h1[i + 1] = (h1[i] * B1 + s[i]) % M1;\n        h2[i + 1] = (h2[i] * B2 + s[i]) % M2;\n    }\n    vector<ll> keys;\n    for (int i = 0; i + k <= n; i++) {\n        ll x = ((h1[i + k] - h1[i] * t1) % M1 + M1) % M1;\n        ll y = ((h2[i + k] - h2[i] * t2) % M2 + M2) % M2;\n        keys.push_back(x * M2 + y);\n    }\n    sort(keys.begin(), keys.end());\n    keys.erase(unique(keys.begin(), keys.end()), keys.end());\n    cout << keys.size() << \"\\n\";\n    return 0;\n}\n"
  }
