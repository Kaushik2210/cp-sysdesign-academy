    "python": "import sys\ndata = sys.stdin.read().split()\nn = int(data[0])\nsegs = [tuple(int(v) for v in data[1 + 4 * i:5 + 4 * i]) for i in range(n)]\n# for each pair decide whether the segments share a point, using only integer cross products\n",
    "javascript": "const lines = [];\nlet line;\nwhile ((line = readLine()) !== null) lines.push(line);\nconst tok = lines.join(' ').split(/\\s+/).filter(s => s.length).map(Number);\nconst n = tok[0];\n",
    "java": "import java.io.*;\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) throws IOException {\n        // read n and the segments; use long for cross products\n    }\n}\n",
    "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main() {\n    // read n and the segments; use long long for cross products\n    return 0;\n}\n"
  },
  "solutions": {
    "python": "import sys\ndata = sys.stdin.read().split()\nn = int(data[0])\nsegs = [tuple(int(v) for v in data[1 + 4 * i:5 + 4 * i]) for i in range(n)]\n\ndef orient(ax, ay, bx, by, cx, cy):\n    \"\"\"Sign of the cross product (b - a) x (c - a): +1 counter-clockwise, -1 clockwise, 0 collinear.\"\"\"\n    v = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax)\n    return (v > 0) - (v < 0)\n\ndef on_segment(ax, ay, bx, by, px, py):\n    \"\"\"For a point p already known to be collinear with a-b: is it inside the bounding box, hence on the segment?\"\"\"\n    return min(ax, bx) <= px <= max(ax, bx) and min(ay, by) <= py <= max(ay, by)\n\ndef intersect(s, t):\n    x1, y1, x2, y2 = s\n    x3, y3, x4, y4 = t\n    d1 = orient(x3, y3, x4, y4, x1, y1)\n    d2 = orient(x3, y3, x4, y4, x2, y2)\n    d3 = orient(x1, y1, x2, y2, x3, y3)\n    d4 = orient(x1, y1, x2, y2, x4, y4)\n    if d1 * d2 < 0 and d3 * d4 < 0:\n        return True                                       # a proper crossing: each segment straddles the other's line\n    if d1 == 0 and on_segment(x3, y3, x4, y4, x1, y1):\n        return True                                       # an endpoint lies on the other segment (touching or overlapping)\n    if d2 == 0 and on_segment(x3, y3, x4, y4, x2, y2):\n        return True\n    if d3 == 0 and on_segment(x1, y1, x2, y2, x3, y3):\n        return True\n    if d4 == 0 and on_segment(x1, y1, x2, y2, x4, y4):\n        return True\n    return False\n\ncount = 0\nfor i in range(n):\n    for j in range(i + 1, n):\n        if intersect(segs[i], segs[j]):\n            count += 1\nprint(count)\n",
    "javascript": "const lines = [];\nlet line;\nwhile ((line = readLine()) !== null) lines.push(line);\nconst tok = lines.join(' ').split(/\\s+/).filter(s => s.length).map(Number);\nconst n = tok[0];\nconst segs = [];\nfor (let i = 0; i < n; i++) segs.push(tok.slice(1 + 4 * i, 5 + 4 * i));\nfunction orient(ax, ay, bx, by, cx, cy) {\n  const v = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax);\n  return v > 0 ? 1 : (v < 0 ? -1 : 0);\n}\nfunction onSegment(ax, ay, bx, by, px, py) {\n  return Math.min(ax, bx) <= px && px <= Math.max(ax, bx) && Math.min(ay, by) <= py && py <= Math.max(ay, by);\n}\nfunction intersect(s, t) {\n  const [x1, y1, x2, y2] = s, [x3, y3, x4, y4] = t;\n  const d1 = orient(x3, y3, x4, y4, x1, y1), d2 = orient(x3, y3, x4, y4, x2, y2);\n  const d3 = orient(x1, y1, x2, y2, x3, y3), d4 = orient(x1, y1, x2, y2, x4, y4);\n  if (d1 * d2 < 0 && d3 * d4 < 0) return true;\n  if (d1 === 0 && onSegment(x3, y3, x4, y4, x1, y1)) return true;\n  if (d2 === 0 && onSegment(x3, y3, x4, y4, x2, y2)) return true;\n  if (d3 === 0 && onSegment(x1, y1, x2, y2, x3, y3)) return true;\n  if (d4 === 0 && onSegment(x1, y1, x2, y2, x4, y4)) return true;\n  return false;\n}\nlet count = 0;\nfor (let i = 0; i < n; i++) for (let j = i + 1; j < n; j++) if (intersect(segs[i], segs[j])) count++;\nconsole.log(String(count));\n",
    "java": "import java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static int orient(long ax, long ay, long bx, long by, long cx, long cy) {\n        long v = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax);\n        return v > 0 ? 1 : (v < 0 ? -1 : 0);\n    }\n\n    static boolean onSegment(long ax, long ay, long bx, long by, long px, long py) {\n        return Math.min(ax, bx) <= px && px <= Math.max(ax, bx) && Math.min(ay, by) <= py && py <= Math.max(ay, by);\n    }\n\n    static boolean intersect(long[] s, long[] t) {\n        long x1 = s[0], y1 = s[1], x2 = s[2], y2 = s[3], x3 = t[0], y3 = t[1], x4 = t[2], y4 = t[3];\n        int d1 = orient(x3, y3, x4, y4, x1, y1), d2 = orient(x3, y3, x4, y4, x2, y2);\n        int d3 = orient(x1, y1, x2, y2, x3, y3), d4 = orient(x1, y1, x2, y2, x4, y4);\n        if (d1 * d2 < 0 && d3 * d4 < 0) return true;\n        if (d1 == 0 && onSegment(x3, y3, x4, y4, x1, y1)) return true;\n        if (d2 == 0 && onSegment(x3, y3, x4, y4, x2, y2)) return true;\n        if (d3 == 0 && onSegment(x1, y1, x2, y2, x3, y3)) return true;\n        if (d4 == 0 && onSegment(x1, y1, x2, y2, x4, y4)) return true;\n        return false;\n    }\n\n    public static void main(String[] args) throws IOException {\n        StreamTokenizer in = new StreamTokenizer(new BufferedInputStream(System.in));\n        in.nextToken();\n        int n = (int) in.nval;\n        long[][] segs = new long[n][4];\n        for (int i = 0; i < n; i++)\n            for (int k = 0; k < 4; k++) { in.nextToken(); segs[i][k] = (long) in.nval; }\n        long count = 0;\n        for (int i = 0; i < n; i++)\n            for (int j = i + 1; j < n; j++)\n                if (intersect(segs[i], segs[j])) count++;\n        System.out.println(count);\n    }\n}\n",
    "cpp": "#include <bits/stdc++.h>\nusing namespace std;\ntypedef long long ll;\n\nint orient(ll ax, ll ay, ll bx, ll by, ll cx, ll cy) {\n    ll v = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax);\n    return (v > 0) - (v < 0);\n}\nbool on_segment(ll ax, ll ay, ll bx, ll by, ll px, ll py) {\n    return min(ax, bx) <= px && px <= max(ax, bx) && min(ay, by) <= py && py <= max(ay, by);\n}\nbool intersect(const array<ll,4>& s, const array<ll,4>& t) {\n    ll x1 = s[0], y1 = s[1], x2 = s[2], y2 = s[3], x3 = t[0], y3 = t[1], x4 = t[2], y4 = t[3];\n    int d1 = orient(x3, y3, x4, y4, x1, y1), d2 = orient(x3, y3, x4, y4, x2, y2);\n    int d3 = orient(x1, y1, x2, y2, x3, y3), d4 = orient(x1, y1, x2, y2, x4, y4);\n    if (d1 * d2 < 0 && d3 * d4 < 0) return true;\n    if (d1 == 0 && on_segment(x3, y3, x4, y4, x1, y1)) return true;\n    if (d2 == 0 && on_segment(x3, y3, x4, y4, x2, y2)) return true;\n    if (d3 == 0 && on_segment(x1, y1, x2, y2, x3, y3)) return true;\n    if (d4 == 0 && on_segment(x1, y1, x2, y2, x4, y4)) return true;\n    return false;\n}\nint main() {\n    int n;\n    scanf(\"%d\", &n);\n    vector<array<ll,4>> segs(n);\n    for (auto& s : segs) scanf(\"%lld %lld %lld %lld\", &s[0], &s[1], &s[2], &s[3]);\n    long long count = 0;\n    for (int i = 0; i < n; i++)\n        for (int j = i + 1; j < n; j++)\n            if (intersect(segs[i], segs[j])) count++;\n    printf(\"%lld\\n\", count);\n    return 0;\n}\n"
  }
}
