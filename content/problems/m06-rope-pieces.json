    "cpp": "#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n    // Largest equal piece length, in hundredths.\n    // your code here\n}\n",
    "java": "import java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner in = new Scanner(System.in);\n        // Largest equal piece length, in hundredths.\n        // your code here\n    }\n}\n"
  },
  "solutions": {
    "python": "import sys\n\ndef main():\n    d = sys.stdin.read().split()\n    n, k = int(d[0]), int(d[1])\n    a = list(map(int, d[2:2 + n]))\n\n    def ok(c):                       # pieces of length c/100 each\n        return sum(x * 100 // c for x in a) >= k\n\n    lo, hi = 1, 100 * max(a)         # ok(1) is true because k <= sum(a)\n    while lo < hi:\n        mid = (lo + hi + 1) // 2\n        if ok(mid):\n            lo = mid\n        else:\n            hi = mid - 1\n    print(lo)\n\nmain()\n",
    "javascript": "const __L = [];\nlet __s;\nwhile ((__s = readLine()) !== null) __L.push(__s);\nconst T = __L.join(' ').split(/\\s+/).filter((x) => x.length).map(Number);\nconst n = T[0], k = T[1];\nconst a = T.slice(2, 2 + n);\nfunction ok(c) {\n  let tot = 0;\n  for (const x of a) tot += Math.floor((x * 100) / c);\n  return tot >= k;\n}\nlet lo = 1, hi = 100 * Math.max(...a);\nwhile (lo < hi) {\n  const mid = Math.floor((lo + hi + 1) / 2);\n  if (ok(mid)) lo = mid; else hi = mid - 1;\n}\nconsole.log(String(lo));\n",
    "java": "import java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static StreamTokenizer st;\n\n    static long nl() throws IOException {\n        st.nextToken();\n        return (long) st.nval;\n    }\n\n    public static void main(String[] args) throws IOException {\n        st = new StreamTokenizer(new BufferedInputStream(System.in));\n        int n = (int) nl();\n        long k = nl();\n        long[] a = new long[n];\n        long mx = 0;\n        for (int i = 0; i < n; i++) {\n            a[i] = nl();\n            mx = Math.max(mx, a[i]);\n        }\n        long lo = 1, hi = 100 * mx;\n        while (lo < hi) {\n            long mid = (lo + hi + 1) / 2;\n            long tot = 0;\n            for (int i = 0; i < n; i++) tot += a[i] * 100 / mid;\n            if (tot >= k) lo = mid; else hi = mid - 1;\n        }\n        System.out.println(lo);\n    }\n}\n",
    "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main() {\n    int n;\n    long long k;\n    scanf(\"%d %lld\", &n, &k);\n    vector<long long> a(n);\n    long long mx = 0;\n    for (auto &v : a) {\n        scanf(\"%lld\", &v);\n        mx = max(mx, v);\n    }\n    long long lo = 1, hi = 100 * mx;\n    while (lo < hi) {\n        long long mid = (lo + hi + 1) / 2;\n        long long tot = 0;\n        for (int i = 0; i < n; i++) tot += a[i] * 100 / mid;\n        if (tot >= k) lo = mid; else hi = mid - 1;\n    }\n    printf(\"%lld\\n\", lo);\n}\n"
  }
