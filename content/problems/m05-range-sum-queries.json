  "hints": [
    "Summing each range separately costs O(n) per query. Can you spend O(n) once so each query is O(1)?",
    "Let `pre[i]` be the sum of the first `i` elements. How does `sum(l..r)` relate to `pre[r]` and `pre[l-1]`?",
    "`sum(l..r) = pre[r] - pre[l-1]`. Use 64-bit integers for `pre`."
  ],
  "editorial": "Build `pre[0] = 0`, `pre[i] = pre[i-1] + a[i]`. Then `sum(l..r) = pre[r] - pre[l-1]` because the shared prefix cancels. Preprocessing is `O(n)` and each query `O(1)`, so total `O(n + q)` instead of `O(nq)`.\n\nSums reach `2·10^5 · 10^9`, beyond 32 bits, so use `long long` / `long`. Off-by-one errors are the main risk: keep `pre` one longer than the array and index queries 1-based.",
  "complexity": {
    "time": "O(n)",
    "space": "O(n)"
  },
  "starter": {
    "python": "import sys\n\n# Answer each range-sum query.\ndata = sys.stdin.read().split()\n# your code here\n",
    "javascript": "// Answer each range-sum query.\n// readLine() returns the next line of input (or null).\n// your code here\n",
    "cpp": "#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n    // Answer each range-sum query.\n    // your code here\n}\n",
    "java": "import java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner in = new Scanner(System.in);\n        // Answer each range-sum query.\n        // your code here\n    }\n}\n"
  },
  "solutions": {
    "python": "import sys\n\ndef main():\n    d = sys.stdin.read().split()\n    n, q = int(d[0]), int(d[1])\n    pre = [0] * (n + 1)\n    for i in range(n):\n        pre[i + 1] = pre[i] + int(d[2 + i])\n    out = []\n    for j in range(q):\n        l = int(d[2 + n + 2 * j])\n        r = int(d[3 + n + 2 * j])\n        out.append(pre[r] - pre[l - 1])\n    print(\"\\n\".join(map(str, out)))\n\nmain()\n",
    "javascript": "const __L = [];\nlet __s;\nwhile ((__s = readLine()) !== null) __L.push(__s);\nconst T = __L.join(' ').split(/\\s+/).filter((x) => x.length).map(Number);\nconst n = T[0], q = T[1];\nconst pre = [0];\nfor (let i = 0; i < n; i++) pre.push(pre[i] + T[2 + i]);\nconst out = [];\nfor (let j = 0; j < q; j++) {\n  const l = T[2 + n + 2 * j], r = T[3 + n + 2 * j];\n  out.push(pre[r] - pre[l - 1]);\n}\nconsole.log(out.join(\"\\n\"));\n",
    "java": "import java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static StreamTokenizer st;\n\n    static long nl() throws IOException {\n        st.nextToken();\n        return (long) st.nval;\n    }\n\n    public static void main(String[] args) throws IOException {\n        st = new StreamTokenizer(new BufferedInputStream(System.in));\n        int n = (int) nl(), q = (int) nl();\n        long[] pre = new long[n + 1];\n        for (int i = 0; i < n; i++) pre[i + 1] = pre[i] + nl();\n        StringBuilder sb = new StringBuilder();\n        for (int j = 0; j < q; j++) {\n            int l = (int) nl(), r = (int) nl();\n            sb.append(pre[r] - pre[l - 1]).append('\\n');\n        }\n        System.out.print(sb);\n    }\n}\n",
    "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main() {\n    int n, q;\n    scanf(\"%d %d\", &n, &q);\n    vector<long long> pre(n + 1, 0);\n    for (int i = 0; i < n; i++) {\n        long long v;\n        scanf(\"%lld\", &v);\n        pre[i + 1] = pre[i] + v;\n    }\n    while (q--) {\n        int l, r;\n        scanf(\"%d %d\", &l, &r);\n        printf(\"%lld\\n\", pre[r] - pre[l - 1]);\n    }\n}\n"
  }
