  "solutions": {
    "python": "import sys\n\ndef main():\n    d = sys.stdin.read().split()\n    n = int(d[0])\n    a = list(map(int, d[1:1 + n]))\n    best = cur = a[0]\n    for x in a[1:]:\n        cur = max(x, cur + x)   # extend the streak or restart at x\n        best = max(best, cur)\n    print(best)\n\nmain()\n",
    "javascript": "const __L = [];\nlet __s;\nwhile ((__s = readLine()) !== null) __L.push(__s);\nconst T = __L.join(' ').split(/\\s+/).filter((x) => x.length).map(Number);\nconst n = T[0];\nlet best = T[1], cur = T[1];\nfor (let i = 2; i <= n; i++) {\n  cur = Math.max(T[i], cur + T[i]);\n  best = Math.max(best, cur);\n}\nconsole.log(String(best));\n",
    "java": "import java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static StreamTokenizer st;\n\n    static long nl() throws IOException {\n        st.nextToken();\n        return (long) st.nval;\n    }\n\n    public static void main(String[] args) throws IOException {\n        st = new StreamTokenizer(new BufferedInputStream(System.in));\n        int n = (int) nl();\n        long best = Long.MIN_VALUE, cur = 0;\n        for (int i = 0; i < n; i++) {\n            long v = nl();\n            cur = (i == 0) ? v : Math.max(v, cur + v);\n            best = Math.max(best, cur);\n        }\n        System.out.println(best);\n    }\n}\n",
    "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main() {\n    int n;\n    scanf(\"%d\", &n);\n    long long best = LLONG_MIN, cur = 0;\n    for (int i = 0; i < n; i++) {\n        long long v;\n        scanf(\"%lld\", &v);\n        cur = (i == 0) ? v : max(v, cur + v);\n        best = max(best, cur);\n    }\n    printf(\"%lld\\n\", best);\n}\n"
  }
