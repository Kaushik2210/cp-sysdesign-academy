  "solutions": {
    "python": "n = int(input())\na = list(map(int, input().split()))\nlast = {}\nbest = -1\nfor i, x in enumerate(a):\n    if x in last and (best == -1 or i - last[x] < best):\n        best = i - last[x]\n    last[x] = i\nprint(best)\n",
    "javascript": "const n = parseInt(readLine());\nconst a = readLine().split(' ').map(Number);\nconst last = new Map();\nlet best = -1;\nfor (let i = 0; i < n; i++) {\n  if (last.has(a[i]) && (best === -1 || i - last.get(a[i]) < best)) best = i - last.get(a[i]);\n  last.set(a[i], i);\n}\nconsole.log(String(best));\n",
    "java": "import java.util.*;\nimport java.io.*;\n\npublic class Main {\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        int n = Integer.parseInt(br.readLine().trim());\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        HashMap<Integer, Integer> last = new HashMap<>();\n        int best = -1;\n        for (int i = 0; i < n; i++) {\n            int x = Integer.parseInt(st.nextToken());\n            Integer p = last.get(x);\n            if (p != null && (best == -1 || i - p < best)) best = i - p;\n            last.put(x, i);\n        }\n        System.out.println(best);\n    }\n}\n",
    "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    int n;\n    cin >> n;\n    map<long long, int> last;\n    int best = -1;\n    for (int i = 0; i < n; i++) {\n        long long x;\n        cin >> x;\n        auto it = last.find(x);\n        if (it != last.end() && (best == -1 || i - it->second < best)) best = i - it->second;\n        last[x] = i;\n    }\n    cout << best << \"\\n\";\n}\n"
