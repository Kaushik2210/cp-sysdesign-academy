  "solutions": {
    "python": "import sys\ndata = sys.stdin.read().split()\nn, k = int(data[0]), int(data[1])\ncnt = {}\nans = 0\nfor x in map(int, data[2:2+n]):\n    ans += cnt.get(k - x, 0)\n    cnt[x] = cnt.get(x, 0) + 1\nprint(ans)\n",
    "javascript": "const [n, k] = readLine().trim().split(/\\s+/).map(Number);\nconst a = readLine().trim().split(/\\s+/).map(Number);\nconst cnt = new Map();\nlet ans = 0;\nfor (const x of a) {\n  ans += cnt.get(k - x) || 0;\n  cnt.set(x, (cnt.get(x) || 0) + 1);\n}\nconsole.log(String(ans));\n",
    "java": "import java.util.*;\nimport java.io.*;\n\npublic class Main {\n    public static void main(String[] args) throws IOException {\n        StreamTokenizer in = new StreamTokenizer(new BufferedInputStream(System.in));\n        in.nextToken();\n        int n = (int) in.nval;\n        in.nextToken();\n        long k = (long) in.nval;\n        HashMap<Long, Integer> cnt = new HashMap<>();\n        long ans = 0;\n        for (int i = 0; i < n; i++) {\n            in.nextToken();\n            long x = (long) in.nval;\n            ans += cnt.getOrDefault(k - x, 0);\n            cnt.merge(x, 1, Integer::sum);\n        }\n        System.out.println(ans);\n    }\n}\n",
    "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nstruct H {\n    static uint64_t mix(uint64_t x) {\n        x += 0x9e3779b97f4a7c15ULL;\n        x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ULL;\n        x = (x ^ (x >> 27)) * 0x94d049bb133111ebULL;\n        return x ^ (x >> 31);\n    }\n    size_t operator()(long long x) const {\n        static const uint64_t R = chrono::steady_clock::now().time_since_epoch().count();\n        return mix((uint64_t)x + R);\n    }\n};\nint main() {\n    int n;\n    long long k;\n    cin >> n >> k;\n    unordered_map<long long, int, H> cnt;\n    long long ans = 0;\n    for (int i = 0; i < n; i++) {\n        long long x;\n        cin >> x;\n        auto it = cnt.find(k - x);\n        if (it != cnt.end()) ans += it->second;\n        cnt[x]++;\n    }\n    cout << ans << \"\\n\";\n    return 0;\n}\n"
