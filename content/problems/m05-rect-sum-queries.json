    "python": "import sys\n\ndef main():\n    d = sys.stdin.read().split()\n    n, m, q = int(d[0]), int(d[1]), int(d[2])\n    p = 3\n    P = [[0] * (m + 1) for _ in range(n + 1)]\n    for i in range(n):\n        for j in range(m):\n            P[i + 1][j + 1] = int(d[p]) + P[i][j + 1] + P[i + 1][j] - P[i][j]\n            p += 1\n    out = []\n    for _ in range(q):\n        r1, c1, r2, c2 = (int(x) for x in d[p:p + 4])\n        p += 4\n        out.append(P[r2][c2] - P[r1 - 1][c2] - P[r2][c1 - 1] + P[r1 - 1][c1 - 1])\n    print(\"\\n\".join(map(str, out)))\n\nmain()\n",
    "javascript": "const __L = [];\nlet __s;\nwhile ((__s = readLine()) !== null) __L.push(__s);\nconst T = __L.join(' ').split(/\\s+/).filter((x) => x.length).map(Number);\nconst n = T[0], m = T[1], q = T[2];\nlet p = 3;\nconst P = [];\nfor (let i = 0; i <= n; i++) P.push(new Array(m + 1).fill(0));\nfor (let i = 0; i < n; i++) {\n  for (let j = 0; j < m; j++) {\n    P[i + 1][j + 1] = T[p++] + P[i][j + 1] + P[i + 1][j] - P[i][j];\n  }\n}\nconst out = [];\nfor (let k = 0; k < q; k++) {\n  const r1 = T[p], c1 = T[p + 1], r2 = T[p + 2], c2 = T[p + 3];\n  p += 4;\n  out.push(P[r2][c2] - P[r1 - 1][c2] - P[r2][c1 - 1] + P[r1 - 1][c1 - 1]);\n}\nconsole.log(out.join(\"\\n\"));\n",
    "java": "import java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static StreamTokenizer st;\n\n    static long nl() throws IOException {\n        st.nextToken();\n        return (long) st.nval;\n    }\n\n    public static void main(String[] args) throws IOException {\n        st = new StreamTokenizer(new BufferedInputStream(System.in));\n        int n = (int) nl(), m = (int) nl(), q = (int) nl();\n        long[][] P = new long[n + 1][m + 1];\n        for (int i = 0; i < n; i++)\n            for (int j = 0; j < m; j++)\n                P[i + 1][j + 1] = nl() + P[i][j + 1] + P[i + 1][j] - P[i][j];\n        StringBuilder sb = new StringBuilder();\n        for (int k = 0; k < q; k++) {\n            int r1 = (int) nl(), c1 = (int) nl(), r2 = (int) nl(), c2 = (int) nl();\n            sb.append(P[r2][c2] - P[r1 - 1][c2] - P[r2][c1 - 1] + P[r1 - 1][c1 - 1]).append('\\n');\n        }\n        System.out.print(sb);\n    }\n}\n",
    "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main() {\n    int n, m, q;\n    scanf(\"%d %d %d\", &n, &m, &q);\n    vector<vector<long long>> P(n + 1, vector<long long>(m + 1, 0));\n    for (int i = 0; i < n; i++)\n        for (int j = 0; j < m; j++) {\n            long long v;\n            scanf(\"%lld\", &v);\n            P[i + 1][j + 1] = v + P[i][j + 1] + P[i + 1][j] - P[i][j];\n        }\n    while (q--) {\n        int r1, c1, r2, c2;\n        scanf(\"%d %d %d %d\", &r1, &c1, &r2, &c2);\n        printf(\"%lld\\n\", P[r2][c2] - P[r1 - 1][c2] - P[r2][c1 - 1] + P[r1 - 1][c1 - 1]);\n    }\n}\n"
