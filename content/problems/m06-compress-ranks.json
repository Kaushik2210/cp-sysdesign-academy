    "python": "import sys\n\n# Map values to dense ranks 0..m-1.\ndata = sys.stdin.read().split()\n# your code here\n",
    "javascript": "// Map values to dense ranks 0..m-1.\n// readLine() returns the next line of input (or null).\n// your code here\n",
    "cpp": "#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n    // Map values to dense ranks 0..m-1.\n    // your code here\n}\n",
    "java": "import java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner in = new Scanner(System.in);\n        // Map values to dense ranks 0..m-1.\n        // your code here\n    }\n}\n"
  },
  "solutions": {
    "python": "import sys\n\ndef main():\n    d = sys.stdin.read().split()\n    n = int(d[0])\n    a = list(map(int, d[1:1 + n]))\n    uniq = sorted(set(a))\n    rank = {v: i for i, v in enumerate(uniq)}\n    print(\" \".join(str(rank[x]) for x in a))\n\nmain()\n",
    "javascript": "const __L = [];\nlet __s;\nwhile ((__s = readLine()) !== null) __L.push(__s);\nconst T = __L.join(' ').split(/\\s+/).filter((x) => x.length).map(Number);\nconst n = T[0];\nconst a = T.slice(1, 1 + n);\nconst uniq = Array.from(new Set(a)).sort((x, y) => x - y);\nconst rank = new Map();\nuniq.forEach((v, i) => rank.set(v, i));\nconsole.log(a.map((x) => rank.get(x)).join(\" \"));\n",
    "java": "import java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static StreamTokenizer st;\n\n    static long nl() throws IOException {\n        st.nextToken();\n        return (long) st.nval;\n    }\n\n    public static void main(String[] args) throws IOException {\n        st = new StreamTokenizer(new BufferedInputStream(System.in));\n        int n = (int) nl();\n        long[] a = new long[n];\n        for (int i = 0; i < n; i++) a[i] = nl();\n        long[] s = a.clone();\n        Arrays.sort(s);\n        int m = 0;\n        for (int i = 0; i < n; i++) if (i == 0 || s[i] != s[i - 1]) s[m++] = s[i];\n        StringBuilder sb = new StringBuilder();\n        for (int i = 0; i < n; i++) {\n            if (i > 0) sb.append(' ');\n            sb.append(Arrays.binarySearch(s, 0, m, a[i]));\n        }\n        System.out.println(sb);\n    }\n}\n",
    "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main() {\n    int n;\n    scanf(\"%d\", &n);\n    vector<long long> a(n);\n    for (auto &v : a) scanf(\"%lld\", &v);\n    vector<long long> s = a;\n    sort(s.begin(), s.end());\n    s.erase(unique(s.begin(), s.end()), s.end());\n    for (int i = 0; i < n; i++) {\n        int r = lower_bound(s.begin(), s.end(), a[i]) - s.begin();\n        printf(\"%d%c\", r, i + 1 < n ? ' ' : '\\n');\n    }\n}\n"
