  "solutions": {
    "python": "import sys\n\ndef main():\n    d = sys.stdin.read().split()\n    n = int(d[0])\n    ev = []\n    for i in range(n):\n        ev.append((int(d[1 + 2 * i]), 1))    # start: +1\n        ev.append((int(d[2 + 2 * i]), -1))   # end: -1 sorts before +1 at equal time\n    ev.sort()\n    cur = best = 0\n    for _, delta in ev:\n        cur += delta\n        best = max(best, cur)\n    print(best)\n\nmain()\n",
    "javascript": "const __L = [];\nlet __s;\nwhile ((__s = readLine()) !== null) __L.push(__s);\nconst T = __L.join(' ').split(/\\s+/).filter((x) => x.length).map(Number);\nconst n = T[0];\nconst ev = [];\nfor (let i = 0; i < n; i++) {\n  ev.push([T[1 + 2 * i], 1]);\n  ev.push([T[2 + 2 * i], -1]);\n}\nev.sort((x, y) => x[0] - y[0] || x[1] - y[1]);\nlet cur = 0, best = 0;\nfor (const [, d] of ev) {\n  cur += d;\n  best = Math.max(best, cur);\n}\nconsole.log(String(best));\n",
    "java": "import java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static StreamTokenizer st;\n\n    static long nl() throws IOException {\n        st.nextToken();\n        return (long) st.nval;\n    }\n\n    public static void main(String[] args) throws IOException {\n        st = new StreamTokenizer(new BufferedInputStream(System.in));\n        int n = (int) nl();\n        long[] ev = new long[2 * n];\n        for (int i = 0; i < n; i++) {\n            long s = nl(), e = nl();\n            ev[2 * i] = s * 2 + 1;      // low bit 1 = start\n            ev[2 * i + 1] = e * 2;      // low bit 0 = end, sorts first at equal time\n        }\n        Arrays.sort(ev);\n        int cur = 0, best = 0;\n        for (long x : ev) {\n            cur += (x & 1) == 1 ? 1 : -1;\n            best = Math.max(best, cur);\n        }\n        System.out.println(best);\n    }\n}\n",
    "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main() {\n    int n;\n    scanf(\"%d\", &n);\n    vector<pair<int, int>> ev;\n    for (int i = 0; i < n; i++) {\n        int s, e;\n        scanf(\"%d %d\", &s, &e);\n        ev.push_back({s, 1});\n        ev.push_back({e, -1});\n    }\n    sort(ev.begin(), ev.end());\n    int cur = 0, best = 0;\n    for (auto &p : ev) {\n        cur += p.second;\n        best = max(best, cur);\n    }\n    printf(\"%d\\n\", best);\n}\n"
